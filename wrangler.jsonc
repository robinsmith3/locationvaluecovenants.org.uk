{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "location-value-covenants",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-20",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "env": {
    "staging": {
      "vars": {
        "ENVIRONMENT": "staging"
      },
      "workers_dev": true,
      "preview_urls": true
    },
    "production": {
      "vars": {
        "ENVIRONMENT": "production"
      },
      "workers_dev": true,
      "preview_urls": true
    }
  }
}
